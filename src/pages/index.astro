---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/HomeHero.astro';
import HighlightPlayTile from '../components/HighlightPlayTile.astro';
import ImageGallery from '../components/ImageGallery.astro';
import BentoTile from '../components/BentoTile.astro';
import EmotionCarousel from '../components/EmotionCarousel.astro';
import directus, { DIRECTUS_URL, type Stueck } from '../lib/directus';
import { readItems, readSingleton } from '@directus/sdk';
import { inferRemoteSize } from 'astro:assets';
import { mapHighlightPlay } from '../lib/mappers';

// 1. Fetch Data
const [startseite, ticketPromo, latestPlays] = (await Promise.all([
  directus
    .request(
      readSingleton('startseite', {
        fields: [
          'emotionen_titel',
          'emotionen_gallerie.directus_files_id.*',
          'impressionen_gallerie.directus_files_id.*',
        ],
      } as any),
    )
    .catch(() => null),
  directus
    .request(
      readSingleton('ticket_promotion', {
        fields: [
          'anzeige_modus',
          'titel',
          'vorab_titel',
          'kurzbeschreibung',
          'vorab_text',
          'vorab_bild',
          'termin_1',
          'termin_2',
          'termin_3',
          'termin_4',
          'termin_5',
          'termin_6',
          'ticketlotse_link',
          'hauptfoto',
        ],
      } as any),
    )
    .catch(() => ({ anzeige_modus: 'inaktiv' }) as any),
  directus
    .request(
      readItems('stuecke', {
        fields: [
          'id',
          'titel',
          'synopsis',
          'auffuehrung_im_jahr',
          'titelfoto',
          'slug',
        ],
        sort: ['-auffuehrung_im_jahr'] as any,
        filter: { veroffentlicht: { _eq: true } } as any,
        limit: 1,
      }),
    )
    .catch(() => []),
])) as [any, any, Stueck[]];

const lastPlay = latestPlays.length > 0 ? latestPlays[0] : null;

// 2. Map Data
const highlightPlay = mapHighlightPlay(ticketPromo, lastPlay, DIRECTUS_URL);

const impressionImages =
  startseite?.impressionen_gallerie &&
  Array.isArray(startseite.impressionen_gallerie)
    ? startseite.impressionen_gallerie.map((img: any) => ({
        src: `${DIRECTUS_URL}/assets/${img.directus_files_id?.id || img.directus_files_id || img}`,
        width: img.directus_files_id?.width || 1600,
        height: img.directus_files_id?.height || 1200,
        thumbnail: `${DIRECTUS_URL}/assets/${img.directus_files_id?.id || img.directus_files_id || img}`,
        id: img.directus_files_id?.id || img.directus_files_id || img,
      }))
    : [];

const emotionImages = startseite?.emotionen_gallerie && Array.isArray(startseite.emotionen_gallerie)
  ? startseite.emotionen_gallerie
      .map((img: any) => {
        const file = img.directus_files_id;
        const fileId = file?.id || file || img;
        if (!fileId) return null;
        return {
          src: `${DIRECTUS_URL}/assets/${fileId}`,
          width: file?.width || 800,
          height: file?.height || 600,
          id: fileId,
        };
      })
      .filter((img: any) => img !== null)
  : [];

const emotionTitel = startseite?.emotionen_titel || '';

// Infer dimensions for the first emotion image to prevent cropping and set stable aspect ratio
let emotionWidth = 800;
let emotionHeight = 600;

if (emotionImages.length > 0) {
  try {
    const dims = await inferRemoteSize(emotionImages[0].src);
    const originalAspectRatio = dims.width / dims.height;
    // Cap at a reasonable width for the bento tile (retina safe)
    emotionWidth = Math.min(dims.width, 800);
    emotionHeight = Math.round(emotionWidth / originalAspectRatio);
  } catch (e) {
    console.warn('Could not infer remote size for first emotion image', e);
  }
}

const emotionAspectRatio = `${emotionWidth} / ${emotionHeight}`;
---

<Layout title="Startseite">
  <HomeHero
    isTicketsActive={ticketPromo?.anzeige_modus !== 'inaktiv'}
    lastPlay={lastPlay}
  />

  <section class="container bento-section">
    <div class="bento-grid">
      <!-- Tile A: Highlight Play (Dynamic) -->
      {highlightPlay && <HighlightPlayTile play={highlightPlay} />}

      <!-- Tile B: Backstage Impression -->
      <BentoTile
        class="tile-image"
        style={emotionImages.length > 0
          ? `aspect-ratio: ${emotionAspectRatio};`
          : ''}
      >
        {
          emotionImages.length > 0 ? (
            <EmotionCarousel
              images={emotionImages}
              title={emotionTitel}
              aspectRatio={emotionAspectRatio}
              width={emotionWidth}
              height={emotionHeight}
            />
          ) : (
            <div
              class="tile-bg-image"
              style="background: rgba(255,255,255,0.02); aspect-ratio: 4 / 3;"
            />
          )
        }
      </BentoTile>

      <!-- Tile C: Tradition -->
      <BentoTile class="tile-stat">
        <span class="stat-number">1905</span>
        <span class="stat-label">Gründungsjahr</span>
        <p
          style="margin-top: 1rem; color: var(--text-muted); font-size: 0.9rem;"
        >
          Über 100 Jahre Tradition in Kleinraming.
        </p>
      </BentoTile>

      <!-- Tile D: Actors Link -->
      <BentoTile class="tile-actors">
        <h3>Unsere Theatermenschen</h3>
        <p style="color: var(--text-muted); font-size: 0.9rem;">
          Das Herzstück unseres Vereins – vor und hinter der Bühne.
        </p>
        <a
          href="/theatermenschen"
          class="btn btn-outline"
          data-umami-event="Theatermenschen Klick"
          data-umami-event-source="Startseite">Zu den Theathermenschen</a
        >
      </BentoTile>
    </div>
  </section>

  <section class="container impression-section">
    <h2>Highlights</h2>
    <ImageGallery images={impressionImages} title="Impressionen" />
  </section>
</Layout>

<style>
  /* Bento Grid Layout */
  .bento-section {
    margin-bottom: 6rem;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  :global(.tile-image) {
    padding: 0 !important;
    min-height: 0 !important; /* Allow it to be smaller than the default bento tile min-height */
  }

  @media (min-width: 1024px) {
    .bento-grid {
      grid-template-columns: 1.5fr 1fr;
      /* Rows should accommodate content but have stable minimums */
      grid-template-rows: repeat(3, minmax(220px, auto));
    }

    :global(.tile-next-play) {
      grid-column: 1;
      grid-row: span 3;
    }
  }

  .tile-bg-image {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover; /* Fill the tile completely */
    z-index: 0;
    transition: transform 0.5s ease;
  }



  :global(.tile-stat) {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: 4rem;
    font-weight: 800;
    color: var(--accent-gold);
    line-height: 1.1; /* Slightly more stable than 1 */
    margin-bottom: 0.5rem;
    min-height: 4.5rem; /* Reserve space for the large number */
  }

  .stat-label {
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.9rem;
  }

  :global(.tile-actors) h3 {
    color: var(--accent-green);
  }

  .impression-section {
    margin-bottom: 8rem;
    text-align: center;
  }

  .impression-section h2 {
    margin-bottom: 3rem;
    font-size: 2.5rem;
  }
</style>
